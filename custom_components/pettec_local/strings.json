      "clock": {
        "title": "Clock settings",
        "description": "When enabled, sync once after Home Assistant starts, using its configured local time zone. This setting defaults to off. To sync immediately, use the Sync device clock button. Clock changes affect when stored schedules run. A failed sync is not retried automatically.",
        "data": {
          "sync_time_on_startup": "Sync device clock on Home Assistant startup"
        }
      }
    },
